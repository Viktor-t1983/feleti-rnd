# Local Development Environment
# Copy to .env and fill with your values
# NEVER commit .env to git!

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/feleti_rnd

# ===========================================
# JWT AUTHENTICATION
# Generate with: openssl rand -base64 32
# ===========================================
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# CORS & URLS
# ===========================================
CORS_ORIGIN=http://localhost
FRONTEND_URL=http://localhost

# IMPORTANT: Leave VITE_API_URL empty for production builds!
# Docker will use relative URLs (/api) through nginx proxy
VITE_API_URL=
VITE_CALC_ENGINE_URL=http://localhost:8000

NODE_ENV=development
