#!/bin/sh
# Pre-commit hook to prevent committing secrets
# Install: git config core.hooksPath .husky

echo "🔒 Checking for secrets in staged files..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for .env files in staging (allow .env.example templates)
STAGED_ENV=$(git diff --cached --name-only | grep -E '^\.env' | grep -vE '\.example$' || true)
if [ -n "$STAGED_ENV" ]; then
    echo "${RED}❌ ERROR: Attempting to commit .env files!${NC}"
    echo "${YELLOW}Staged .env files:${NC}"
    echo "$STAGED_ENV"
    echo ""
    echo "Run: git reset HEAD $STAGED_ENV"
    echo "${YELLOW}Note: .env.example files are allowed as templates${NC}"
    exit 1
fi

# Check for API keys patterns (exclude comments, placeholders, and hook itself)
PATTERNS="
sk-[a-zA-Z0-9]{48}
sk_live_[a-zA-Z0-9]{24,}
sk_test_[a-zA-Z0-9]{24,}
bearer[[:space:]]+[a-zA-Z0-9_\-\.]{20,}
api[_-]?key[[:space:]]*[:=][[:space:]]*[a-zA-Z0-9_\-]{16,}
password[[:space:]]*[:=][[:space:]]*[a-zA-Z0-9_\-]{8,}
"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
FOUND_SECRETS=""

for FILE in $STAGED_FILES; do
    # Skip binary files and lock files
    if echo "$FILE" | grep -qE '\.(jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|lock|sql|gz)$'; then
        continue
    fi
    
    # Skip pre-commit hook file itself
    if [ "$FILE" = ".husky/pre-commit" ]; then
        continue
    fi
    
    # Check each pattern (exclude comments and placeholder values)
    for PATTERN in $PATTERNS; do
        MATCHES=$(git show :"$FILE" 2>/dev/null | grep -vE '^[[:space:]]*#|^#|CHANGE_ME|your_|example|template' | grep -iE "$PATTERN" 2>/dev/null | head -3 || true)
        if [ -n "$MATCHES" ]; then
            FOUND_SECRETS="${FOUND_SECRETS}${FILE}\n${MATCHES}\n\n"
        fi
    done
done

if [ -n "$FOUND_SECRETS" ]; then
    echo "${RED}⚠️  WARNING: Potential secrets detected!${NC}"
    echo "${YELLOW}Review these matches:${NC}"
    echo -e "$FOUND_SECRETS"
    echo ""
    echo "${YELLOW}To bypass (if false positive):${NC}"
    echo "  git commit --no-verify"
    echo ""
    read -p "Continue with commit? [y/N] " REPLY
    if [ "$REPLY" != "y" ] && [ "$REPLY" != "Y" ]; then
        echo "${RED}❌ Commit aborted${NC}"
        exit 1
    fi
fi

# Check file sizes (prevent committing large files)
MAX_SIZE=10485760  # 10MB
LARGE_FILES=""
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        SIZE=$(stat -f%z "$FILE" 2>/dev/null || stat -c%s "$FILE" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt "$MAX_SIZE" ]; then
            LARGE_FILES="${LARGE_FILES}${FILE} ($((SIZE/1024/1024))MB)\n"
        fi
    fi
done

if [ -n "$LARGE_FILES" ]; then
    echo "${RED}❌ ERROR: Large files detected (>10MB):${NC}"
    echo -e "$LARGE_FILES"
    exit 1
fi

echo "${GREEN}✅ No secrets detected${NC}"
exit 0
