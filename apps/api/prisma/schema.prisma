generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStage {
  IDEA
  CONCEPT
  DESIGN
  PROTOTYPE
  TESTING
  PRODUCTION
  COMPLETED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  COMPLETED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  fullName      String
  isBlocked     Boolean   @default(false)
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  telegramId    String?   @unique
  preferences   Json?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      UserSession[]
  ownedProjects Project[] @relation("ProjectOwner")
  projectMembers ProjectMember[]
  assignedTasks Task[]    @relation("TaskAssignee")
  comments      Comment[]
  auditLogs     AuditLog[]
  authoredLessons LessonLearned[]
  authoredVocs  VoiceOfCustomer[]
  uploadedAttachments Attachment[] @relation("UploadedAttachments")
  notifications Notification[]
  activityLogs ActivityLog[]
  createdTemplates ProjectTemplate[]
  
  // Knowledge Base Relations
  createdEquipmentTypes EquipmentType[]

  // Engineering Platform Relations
  knowledgeNodes         KnowledgeNode[]
  acknowledgedViolations RuleViolation[]  @relation("AcknowledgedViolations")
  resolvedViolations    RuleViolation[]  @relation("ResolvedViolations")
  waivedViolations      RuleViolation[]  @relation("WaivedViolations")
  validatedGates        GateValidation[] @relation("ValidatedGates")
  waivedGates           GateValidation[] @relation("WaivedGates")
  calculations          Calculation[]
  agentMemories         AgentMemory[]

  @@index([email])
  @@index([roleId])
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  permissions  Json
  isSystem     Boolean  @default(false)
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Project {
  id              String    @id @default(uuid())
  code            String    @unique
  name            String
  description     String?
  stage           ProjectStage @default(CONCEPT)
  status          ProjectStatus @default(ACTIVE)
  priority        String    @default("medium")
  ownerId         String
  owner           User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  targetDate      DateTime?
  completedAt     DateTime?
  budget          Float?
  spent           Float     @default(0)
  scores          Json?
  financials      Financial[]
  competitorLinks CompetitorProject[]
  documents       Document[]
  attachments     Attachment[]
  tasks           Task[]
  comments        Comment[]
  lessonsLearned  LessonLearned[]
  vocs            VoiceOfCustomer[]
  members         ProjectMember[]
  activityLogs    ActivityLog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Engineering Platform Relations
  productClassId   String?
  productClass    ProductClass?     @relation(fields: [productClassId], references: [id])
  productParams   Json?              // Технические параметры продукта
  knowledgeNodes  KnowledgeNode[]
  ruleViolations  RuleViolation[]
  gateValidations GateValidation[]
  calculations    Calculation[]
  agentMemories   AgentMemory[]
  
  // Knowledge Base Relations
  equipmentTypes  EquipmentType[] @relation("ProjectEquipment")
  
  // Charter Relations
  blocks          ProjectBlock[]

  @@index([code])
  @@index([ownerId])
  @@index([stage])
  @@index([status])
  @@index([name]) // For search functionality
  @@index([ownerId, status]) // Composite index for filtering
  @@index([createdAt]) // For sorting
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Financial {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year        Int
  revenue     Float
  cost        Float
  profit      Float
  npv         Float?
  irr         Float?
  payback     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, year])
  @@index([projectId])
}

model Competitor {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  website     String?
  strengths   Json
  weaknesses  Json
  projectLinks CompetitorProject[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompetitorProject {
  id            String   @id @default(uuid())
  projectId     String
  competitorId  String
  project       Project  @relation(fields: [projectId], references: [id])
  competitor    Competitor @relation(fields: [competitorId], references: [id])
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([projectId, competitorId])
  @@index([projectId])
  @@index([competitorId])
}

model Document {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  url         String
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  metadata    Json?

  @@index([projectId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Comment {
  id          String   @id @default(uuid())
  text        String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment? @relation("CommentReply", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReply")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([projectId])
  @@index([taskId])
}

model LessonLearned {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  impact      String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([category])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model VoiceOfCustomer {
  id          String   @id @default(uuid())
  source      String
  customer    String
  feedback    String
  category    String
  sentiment   String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  priority    String   @default("medium")
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([status])
}

model Attachment {
  id          String   @id @default(uuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  projectId   String
  uploadedById String
  createdAt   DateTime @default(now())
  
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy  User    @relation("UploadedAttachments", fields: [uploadedById], references: [id])
  
  @@index([projectId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // TEAM_INVITE, COMMENT, DEADLINE, BUDGET, PROJECT_CREATED
  title     String
  message   String
  link      String?  // Ссылка на проект/комментарий
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, read])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   // PROJECT_CREATED, MEMBER_ADDED, etc.
  entityType  String   // Project, User, Comment, Attachment
  entityId    String
  entityName  String?  // Название проекта/файла для удобства
  changes     Json?    // Что изменилось (до/после)
  userId      String
  projectId   String?  // Опционально - для фильтра
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@index([createdAt])
}

model ProjectTemplate {
  id               String   @id @default(uuid())
  name             String
  description      String?
  defaultStage     String   @default("IDEA")
  estimatedBudget  Decimal? @db.Decimal(15, 2)
  estimatedDays    Int?
  teamSize         Int?
  checklist        Json?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  createdBy        User     @relation(fields: [createdById], references: [id])
  
  @@index([name])
}

// ==========================================
// ENGINEERING PLATFORM v1.0
// Product-Agnostic Architecture
// ==========================================

// ==========================================
// 1. PRODUCT CLASSES FRAMEWORK
// ==========================================

/// Класс продукта (абстрактный тип)
/// Примеры: "Thermal Processing", "Mechanical Processing", "Hygiene Systems"
model ProductClass {
  id                    String    @id @default(uuid())
  code                  String    @unique // "THERMAL", "MECH", "HYGIENE"
  name                  String    // "Термическая обработка"
  description           String?   @db.Text
  icon                  String?   // emoji или иконка
  category              String    // "processing", "infrastructure", "systems"
  
  // Метаданные класса
  metadata              Json?     // Дополнительные параметры
  
  // Типовые характеристики (JSON Templates)
  typicalRequirements   Json?     // Шаблоны требований
  calculationBlockRefs  Json?     // Ссылки на расчётные блоки
  validationCriteria    Json?     // Критерии валидации
  kpiMetrics           Json?     // KPI метрики
  
  // Иерархия
  parentId              String?
  parent                ProductClass?  @relation("ClassHierarchy", fields: [parentId], references: [id])
  children              ProductClass[] @relation("ClassHierarchy")
  
  // Статус
  active                Boolean   @default(true)
  version               String    @default("1.0")
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  // Relations
  projects              Project[]
  knowledgeNodes        KnowledgeNode[]
  engineeringRules      EngineeringRule[]
  validationGates       ValidationGate[]
  calculationBlocks     CalculationBlock[]
  
  @@index([code])
  @@index([category])
  @@index([active])
}

// ==========================================
// 2. ENGINEERING KNOWLEDGE GRAPH
// ==========================================

/// Типы узлов знаний
enum KnowledgeNodeType {
  REQUIREMENT      // Требование
  SOLUTION         // Решение
  PROBLEM          // Проблема
  DECISION         // Инженерное решение
  RISK             // Риск
  COMPONENT        // Компонент/узел
  PRINCIPLE        // Инженерный принцип
  CONSTRAINT       // Ограничение
  LESSON_LEARNED   // Извлечённый урок
}

/// Узел в графе знаний
model KnowledgeNode {
  id                String              @id @default(uuid())
  type              KnowledgeNodeType
  
  // Контент
  title             String
  content           String              @db.Text
  summary           String?             // Краткое описание
  tags              String[]            // Теги для поиска
  
  // Метаданные
  metadata          Json?               // Дополнительная информация
  confidence        Float               @default(1.0) // 0.0 - 1.0
  importance        String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  
  // Контекст
  productClassId    String?
  productClass      ProductClass?       @relation(fields: [productClassId], references: [id])
  
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Versioning
  version           Int                 @default(1)
  supersededById    String?             @unique
  supersededBy      KnowledgeNode?      @relation("NodeVersion", fields: [supersededById], references: [id])
  supersedes        KnowledgeNode?      @relation("NodeVersion")
  
  // Автор
  createdById       String
  createdBy         User                @relation(fields: [createdById], references: [id])
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  // Граф связей
  relationsFrom     KnowledgeRelation[] @relation("FromNode")
  relationsTo       KnowledgeRelation[] @relation("ToNode")
  
  @@index([type])
  @@index([productClassId])
  @@index([projectId])
  @@index([createdAt])
}

/// Типы связей в графе
enum RelationType {
  CAUSES           // Вызывает
  SOLVES           // Решает
  REQUIRES         // Требует
  VALIDATES        // Validates
  DEPENDS_ON       // Зависит от
  CONFLICTS_WITH   // Конфликтует с
  IMPLEMENTS       // Реализует
  DERIVES_FROM     // Происходит от
  RELATES_TO       // Связано с
}

/// Связь между узлами знаний
model KnowledgeRelation {
  id                String        @id @default(uuid())
  type              RelationType
  
  // Связь
  fromNodeId        String
  fromNode          KnowledgeNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  
  toNodeId          String
  toNode            KnowledgeNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  
  // Метаданные связи
  strength          Float         @default(1.0) // 0.0 - 1.0
  confidence        Float         @default(1.0) // 0.0 - 1.0
  description       String?       // Описание связи
  metadata          Json?
  
  createdAt         DateTime      @default(now())
  
  @@unique([fromNodeId, toNodeId, type])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([type])
}

// ==========================================
// 3. RULES ENGINE
// ==========================================

/// Категории правил
enum RuleCategory {
  THERMAL          // Тепловые процессы
  AERODYNAMIC      // Аэродинамика
  MECHANICAL       // Механика
  HYGIENE          // Гигиена
  SAFETY           // Безопасность
  ELECTRICAL       // Электрика
  PROCESS          // Процессы
  QUALITY          // Качество
  CUSTOM           // Пользовательские
}

/// Уровень риска при нарушении правила
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Действие при нарушении
enum RuleAction {
  WARN             // Предупреждение
  BLOCK            // Блокировка
  LOG              // Только логирование
  NOTIFY           // Уведомление
}

/// Инженерное правило
model EngineeringRule {
  id                String        @id @default(uuid())
  code              String        @unique // "THERM-001", "AERO-002"
  category          RuleCategory
  
  // Описание
  name              String
  description       String        @db.Text
  rationale         String?       @db.Text // Обоснование правила
  
  // Условие (JSON DSL)
  condition         Json          // Структура условия
  
  // Параметры
  parameters        Json?         // Описание входных параметров
  
  // Результат нарушения
  riskLevel         RiskLevel
  action            RuleAction
  message           String        @db.Text
  recommendation    String?       @db.Text // Рекомендация по исправлению
  
  // Область применения
  productClassId    String?
  productClass      ProductClass? @relation(fields: [productClassId], references: [id])
  
  scope             String        @default("PROJECT") // PROJECT, GATE, CALCULATION
  
  // Статус
  active            Boolean       @default(true)
  version           String        @default("1.0")
  
  // Метаданные
  tags              String[]
  references        Json?         // Ссылки на стандарты, документы
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  violations        RuleViolation[]
  
  @@index([category])
  @@index([active])
  @@index([riskLevel])
}

/// Статус нарушения правила
enum ViolationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WAIVED         // Отменено (с обоснованием)
}

/// Нарушение правила
model RuleViolation {
  id                String           @id @default(uuid())
  
  ruleId            String
  rule              EngineeringRule  @relation(fields: [ruleId], references: [id])
  
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Контекст нарушения
  context           Json             // Где произошло
  params            Json             // Параметры, вызвавшие нарушение
  
  // Результат проверки
  triggered         Boolean
  severity          RiskLevel
  calculatedRisk    Float?           // Расчётный уровень риска 0-1
  
  // Статус
  status            ViolationStatus  @default(OPEN)
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  acknowledgedBy    User?            @relation("AcknowledgedViolations", fields: [acknowledgedById], references: [id])
  
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?            @relation("ResolvedViolations", fields: [resolvedById], references: [id])
  
  resolution        String?          @db.Text
  
  // Waiver (отмена с обоснованием)
  waived            Boolean          @default(false)
  waiverReason      String?          @db.Text
  waivedById        String?
  waivedBy          User?            @relation("WaivedViolations", fields: [waivedById], references: [id])
  
  createdAt         DateTime         @default(now())
  
  @@index([projectId])
  @@index([status])
  @@index([severity])
}

// ==========================================
// 4. VALIDATION GATES SYSTEM
// ==========================================

/// Контрольная точка (Gate)
model ValidationGate {
  id                String        @id @default(uuid())
  code              String        @unique // "GATE-1", "GATE-2"
  name              String        // "Product Definition Complete"
  description       String        @db.Text
  
  // Порядок и иерархия
  order             Int           // Порядковый номер gate
  phase             String        // "PLANNING", "DESIGN", "VALIDATION", "RELEASE"
  
  // Критерии прохождения (JSON)
  criteria          Json          // Список проверок
  passingScore      Float         @default(0.8) // Минимальный балл для прохождения
  
  // Область применения
  productClassId    String?
  productClass      ProductClass? @relation(fields: [productClassId], references: [id])
  
  // Опции
  blockOnFail       Boolean       @default(true)
  allowWaiver       Boolean       @default(false)
  requiresApproval  Boolean       @default(false)
  
  // Статус
  active            Boolean       @default(true)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  validations       GateValidation[]
  
  @@index([order])
  @@index([active])
  @@index([phase])
}

/// Результат прохождения Gate
model GateValidation {
  id                String         @id @default(uuid())
  
  gateId            String
  gate              ValidationGate @relation(fields: [gateId], references: [id])
  
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Результат
  passed            Boolean
  score             Float          // 0.0 - 1.0
  
  // Детали проверки
  results           Json           // Результаты по каждому критерию
  blockers          Json?          // Что блокирует прохождение
  warnings          Json?          // Предупреждения
  
  // Waiver
  waived            Boolean        @default(false)
  waiverReason      String?        @db.Text
  waivedById        String?
  waivedBy          User?          @relation("WaivedGates", fields: [waivedById], references: [id])
  
  // Валидация
  validatedById     String
  validatedBy       User           @relation("ValidatedGates", fields: [validatedById], references: [id])
  
  validatedAt       DateTime       @default(now())
  
  @@index([projectId])
  @@index([passed])
  @@index([validatedAt])
}

// ==========================================
// 5. CALCULATION BLOCKS SYSTEM
// ==========================================

/// Категории расчётов
enum CalculationCategory {
  THERMAL          // Тепловые расчёты
  AERODYNAMIC      // Аэродинамические
  MECHANICAL       // Механические
  ELECTRICAL       // Электрические
  HYDRAULIC        // Гидравлические
  ECONOMIC         // Экономические
  CUSTOM           // Пользовательские
}

/// Расчётный блок (шаблон)
model CalculationBlock {
  id                String               @id @default(uuid())
  code              String               @unique // "THERM-HEAT-BALANCE"
  category          CalculationCategory
  
  // Описание
  name              String
  description       String               @db.Text
  purpose           String?              @db.Text
  
  // Схема входов/выходов (JSON Schema)
  inputSchema       Json                 // Описание входных параметров
  outputSchema      Json                 // Описание выходных параметров
  
  // Формулы и логика
  formulae          Json                 // Формулы в JSON
  algorithm         String?              @db.Text // Описание алгоритма
  
  // Валидация
  validationRules   Json?                // Правила валидации результатов
  
  // Область применения
  productClassId    String?
  productClass      ProductClass?        @relation(fields: [productClassId], references: [id])
  
  // Метаданные
  units             Json?                // Единицы измерения
  references        Json?                // Ссылки на источники
  accuracy          String?              // Точность расчёта
  
  // Статус
  active            Boolean              @default(true)
  version           String               @default("1.0")
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  
  // Relations
  calculations      Calculation[]
  
  @@index([category])
  @@index([active])
}

/// Статус расчёта
enum CalculationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  WARNING
}

/// Тип расчёта (для простых расчётов без блока)
enum CalculationType {
  NPV
  IRR
  ROI
  PAYBACK
  SHAFT_STRENGTH
  THERMAL
  VENTILATION
  CUSTOM
}

/// Категория расчёта (FINANCIAL или ENGINEERING)
enum CalculationResultCategory {
  FINANCIAL
  ENGINEERING
}

/// Результат выполнения расчёта
model Calculation {
  id                String             @id @default(uuid())

  // Связь с блоком (опционально - для сложных расчётов)
  blockId           String?
  block             CalculationBlock?  @relation(fields: [blockId], references: [id])

  // Тип расчёта (для простых расчётов без блока)
  type              CalculationType?
  category          CalculationResultCategory?

  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Входные данные
  inputs            Json
  inputData         Json?              // Алиас для совместимости

  // Результаты
  outputs           Json?
  resultData        Json?              // Алиас для совместимости

  // Статус
  status            CalculationStatus  @default(SUCCESS)
  isSuccessful      Boolean            @default(true)
  progress          Float              @default(0) // 0-100%

  // Ошибки и предупреждения
  errors            Json?
  warnings          Json?

  // Валидация результатов
  validated         Boolean            @default(false)
  validationResults Json?

  // Заметки инженера
  notes             String?            @db.Text

  // Метаданные выполнения
  executionTime     Int?               // мс
  metadata          Json?

  // Исполнитель
  executedById      String
  executedBy        User               @relation(fields: [executedById], references: [id])

  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// 6. KNOWLEDGE BASE MODULE
// Equipment Catalog, Markets, Competitors
// ==========================================

/// Категория оборудования
enum EquipmentCategory {
  THERMAL          // Термическое оборудование (дымогенераторы, термокамеры)
  MECHANICAL       // Механическое (шпигорезки, фаршемешалки)
  HYDRAULIC        // Гидравлическое
  ELECTRICAL       // Электрическое
  AUTOMATION       // Автоматизация
  PACKAGING        // Упаковочное
  TRANSPORT        // Транспортное
  OTHER            // Прочее
}

/// Единицы измерения для параметров
enum UnitOfMeasure {
  KG
  TON
  LITER
  CUBIC_METER
  METER
  MM
  CELSIUS
  BAR
  KPA
  KWH
  KW
  PERCENT
  PIECES
  HOURS
  MINUTES
}

/// Каталог оборудования
model EquipmentType {
  id              String          @id @default(uuid())
  code            String          @unique // FELETI-TK-100, FELETI-DG-200
  name            String          // Полное название
  shortName       String?         // Краткое название для отображения
  
  category        EquipmentCategory
  description     String?         @db.Text
  specifications  Json?           // Технические характеристики
  
  // Цены и стоимость
  basePrice       Float?          // Базовая цена (EUR)
  currency        String          @default("EUR")
  
  // Изображения и документы
  images          String[]        // URLs изображений
  documentationUrl String?
  
  // Производство
  manufacturer    String          @default("FELETI")
  countryOfOrigin String          @default("DE")
  leadTimeDays    Int?            // Срок поставки в днях
  
  // Статус
  isActive        Boolean         @default(true)
  isCustom        Boolean         @default(false) // true = пользовательское оборудование
  
  // Связи
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id])
  
  // Relations
  projects        Project[]       @relation("ProjectEquipment")
  competitorEquipment CompetitorEquipment[]
  marketEquipment MarketEquipment[]
  templateBlocks  TemplateBlock[] // Charter template blocks
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([category])
  @@index([isActive])
  @@index([code])
}

/// Регион рынка
enum MarketRegion {
  EUROPE
  NORTH_AMERICA
  SOUTH_AMERICA
  ASIA
  AFRICA
  AUSTRALIA
  MIDDLE_EAST
}

/// Рынок сбыта
model Market {
  id              String          @id @default(uuid())
  code            String          @unique // DE, US, CN, RU
  name            String          // Germany, United States, China
  
  region          MarketRegion
  description     String?         @db.Text
  
  // Демография и экономика
  population      Int?            // Население
  gdpPerCapita    Float?          // ВВП на душу населения
  
  // Особенности рынка
  languages       String[]        // Языки
  currencies      String[]        // Валюты
  
  // Мясная индустрия
  meatConsumptionKgPerCapita Float? // Потребление мяса кг/чел/год
  preferredMeatTypes String[]     // Предпочитаемые виды мяса
  
  // Требования
  certificationsRequired String[]  // Требуемые сертификаты
  standards         String[]      // Стандарты
  importTaxes       Json?         // Пошлины на импорт
  
  // Конкуренты на рынке
  competitors     CompetitorMarket[]
  
  // Оборудование на рынке
  equipment       MarketEquipment[]
  
  // Статус
  isActive        Boolean         @default(true)
  priority        Int             @default(0) // Приоритет для компании
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([region])
  @@index([isActive])
  @@index([priority])
}

/// Конкурент (детальная модель для базы знаний)
model CompetitorDetail {
  id              String          @id @default(uuid())
  name            String          @unique
  legalName       String?         // Юридическое название
  
  // Контакты
  website         String?
  email           String?
  phone           String?
  address         String?         @db.Text
  
  // Информация о компании
  foundedYear     Int?
  employeesCount  Int?
  annualRevenue   Float?          // Годовой оборот (млн EUR)
  
  // Рыночная позиция
  marketShare     Float?          // Доля рынка (%)
  strengths       String[]        // Сильные стороны
  weaknesses      String[]        // Слабые стороны
  
  // Продукты
  productRange    String[]        // Ассортимент продукции
  priceSegment    String          @default("mid") // low, mid, premium
  
  // Страны присутствия
  markets         CompetitorMarket[]
  equipment       CompetitorEquipment[]
  
  // Статус
  isActive        Boolean         @default(true)
  threatLevel     String          @default("medium") // low, medium, high
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([isActive])
  @@index([threatLevel])
}

/// Связь конкурент ↔ рынок
model CompetitorMarket {
  id              String          @id @default(uuid())
  competitorId    String
  competitor      CompetitorDetail @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  marketId        String
  market          Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  
  marketShare     Float?          // Доля на конкретном рынке (%)
  entryYear       Int?            // Год входа на рынок
  notes           String?         @db.Text
  
  createdAt       DateTime        @default(now())
  
  @@unique([competitorId, marketId])
  @@index([competitorId])
  @@index([marketId])
}

/// Конкурентное оборудование
model CompetitorEquipment {
  id              String          @id @default(uuid())
  competitorId    String
  competitor      CompetitorDetail @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  
  // Ссылка на наше оборудование (если есть аналог)
  equipmentTypeId String?
  equipmentType   EquipmentType?  @relation(fields: [equipmentTypeId], references: [id])
  
  name            String          // Название у конкурента
  modelNumber     String?         // Модель/артикул
  
  // Характеристики
  specifications  Json?           // Технические характеристики
  advantages      String[]        // Преимущества
  disadvantages   String[]        // Недостатки
  
  // Цена
  priceRangeMin   Float?
  priceRangeMax   Float?
  currency        String          @default("EUR")
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([competitorId])
  @@index([equipmentTypeId])
}

/// Связь оборудование ↔ рынок
model MarketEquipment {
  id              String          @id @default(uuid())
  marketId        String
  market          Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  equipmentTypeId String
  equipmentType   EquipmentType   @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  
  localPrice      Float?          // Локальная цена
  localCurrency   String?
  demandLevel     String          @default("medium") // low, medium, high
  popularity      Int             @default(0) // Популярность 0-100
  
  createdAt       DateTime        @default(now())
  
  @@unique([marketId, equipmentTypeId])
  @@index([marketId])
  @@index([equipmentTypeId])
}

// ==========================================
// 7. CHARTER TEMPLATES SYSTEM
// Гибкие шаблоны уставов RD проектов
// ==========================================

/// Тип блока шаблона устава
enum CharterBlockType {
  TEXT              // Текстовый блок
  PARAMS_TABLE      // Таблица параметров
  RISK_LIST         // Список рисков
  COMPETITORS       // Анализ конкурентов
  DECOMPOSITION     // Декомпозиция подсистем
  GATE_REVIEW       // Ворота решений GO/NO-GO
}

/// Блок шаблона устава
model TemplateBlock {
  id              String          @id @default(uuid())
  equipmentTypeId String
  equipmentType   EquipmentType   @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)

  name            String          // "Привод и трансмиссия"
  icon            String          // ""
  description     String?         @db.Text // подсказка для инженера
  blockType       CharterBlockType // TEXT, PARAMS_TABLE, etc.
  isRequired      Boolean         @default(true)
  sortOrder       Int             @default(0)

  // AI-настройки
  aiEnabled       Boolean         @default(true)
  aiPrompt        String?         @db.Text // инструкция для AI-ассистента
  aiModel         String          @default("deepseek") // "deepseek" | "claude"

  // Поля внутри блока (JSON-схема)
  fieldSchema     Json            @default("{}")
  defaultValues   Json?

  projectBlocks   ProjectBlock[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([equipmentTypeId, sortOrder])
  @@map("template_blocks")
}

/// Статус блока устава проекта
enum ProjectBlockStatus {
  EMPTY
  IN_PROGRESS
  DONE
}

/// Заполненный блок конкретного проекта
model ProjectBlock {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateBlockId String
  templateBlock   TemplateBlock   @relation(fields: [templateBlockId], references: [id])

  data            Json            @default("{}") // заполненные поля
  aiHistory       Json            @default("[]") // история диалога с AI
  aiFlags         Json            @default("[]") // флаги рисков
  status          ProjectBlockStatus @default(EMPTY)

  updatedBy       String
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())

  @@index([projectId])
  @@map("project_blocks")
}

// ==========================================
// 8. AI AGENTS MEMORY & CONTEXT
// ==========================================

/// Типы AI агентов
enum AgentType {
  PORTFOLIO          // Анализ портфеля
  PRODUCT_DEFINITION // Определение продукта
  REQUIREMENTS       // Работа с требованиями
  ARCHITECTURE       // Архитектурные решения
  VALIDATION         // Валидация
  CALCULATION        // Помощь с расчётами
  OPTIMIZATION       // Оптимизация
  RISK_ANALYSIS      // Анализ рисков
}

/// Память AI-агента
model AgentMemory {
  id                String     @id @default(uuid())
  agentType         AgentType
  
  // Контекст
  projectId         String?
  project           Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId            String?
  user              User?      @relation(fields: [userId], references: [id])
  
  productClassId    String?
  
  // Данные памяти
  context           Json       // Контекст работы
  decisions         Json?      // Принятые решения
  learnings         Json?      // Извлечённые уроки
  interactions      Json?      // История взаимодействий
  
  // Метаданные
  sessionId         String?    // ID сессии
  version           Int        @default(1)
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  expiresAt         DateTime?  // Время жизни памяти
  
  @@index([agentType])
  @@index([projectId])
  @@index([userId])
  @@index([sessionId])
}

// ==========================================
// 9. SYSTEM SETTINGS
// Конфигурация системы и API ключи
// ==========================================

/// Тип значения настройки
enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ENCRYPTED  // Зашифрованное значение (для API ключей)
}

/// Системная настройка
model SystemSetting {
  id            String          @id @default(uuid())
  key           String          @unique // Название настройки: "ai.openai.api_key"
  value         String          @db.Text // Значение (может быть зашифрованным)
  valueType     SettingValueType @default(STRING)
  
  // Метаданные
  category      String          @default("general") // general, ai, email, security
  label         String          // Отображаемое название
  description   String?         @db.Text // Описание для админа
  
  // Для зашифрованных значений
  isEncrypted   Boolean         @default(false)
  
  // Кто изменил
  updatedById   String?
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())
  
  @@index([category])
  @@index([key])
  @@map("system_settings")
}

