# Production Environment Variables
# Copy to .env.production and fill with real values
# NEVER commit .env.production to git!

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://user:CHANGE_ME@postgres:5432/feleti_rnd
POSTGRES_USER=feleti
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=feleti_rnd

# ===========================================
# JWT AUTHENTICATION
# Generate secrets with: openssl rand -base64 32
# ===========================================
JWT_SECRET=generate_32_chars_random_string_here_USE_OPENSSL_RAND
JWT_REFRESH_SECRET=generate_another_32_chars_string_here_DIFFERENT
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# CORS & URLS
# ===========================================
CORS_ORIGIN=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Frontend URLs
VITE_API_URL=https://api.your-domain.com
VITE_CALC_ENGINE_URL=https://calc.your-domain.com

# ===========================================
# DEEPSEEK AI (OPTIONAL)
# Get API key at: https://platform.deepseek.com
# ===========================================
DEEPSEEK_API_KEY=your_api_key_here_or_leave_empty
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===========================================
# EMAIL (OPTIONAL)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@your-domain.com

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
NODE_ENV=production
PORT=3001

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Generate strong JWT secrets: openssl rand -base64 32
# 2. Use strong database passwords (16+ chars, mixed)
# 3. Never commit this file with real values
# 4. Rotate secrets periodically
# 5. Use environment variables in production
